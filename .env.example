# --- Telegram ---
# Токен бота от @BotFather
TG_BOT_TOKEN=
# TG user id владельцев бота (через запятую) — кто управляет парами (/link).
TG_ADMINS=
# ID группы Telegram (отрицательное число вида -100xxxxxxxxxx).
# Как узнать: добавь бота в группу, напиши туда любое сообщение —
# бот выведет chat_id в лог (см. README).
TG_CHAT_ID=

# --- VK ---
# Ключ доступа сообщества с правами "Сообщения" (messages).
# Управление сообществом -> Настройки -> Работа с API -> Ключи доступа.
VK_TOKEN=
# peer_id беседы. Для беседы это 2000000000 + chat_id.
# Из твоей ссылки vk.com/im/convo/2000000021 -> 2000000021.
VK_PEER_ID=
# (необязательно) числовой id сообщества. Если пусто — определяется автоматически.
VK_GROUP_ID=

# Токен личного аккаунта — только для нативного видео (video.get / video.save).
VK_USER_TOKEN=

# Уровень логирования
LOG_LEVEL=
