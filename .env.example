# --- Telegram ---
# Токен бота от @BotFather
TG_BOT_TOKEN=123456:ABC-DEF...
# TG user id владельцев бота (через запятую) — кто управляет парами (/link).
# Свой id можно узнать у @userinfobot.
TG_ADMINS=123456789

# (необязательно) Локальный Telegram Bot API сервер — нужен для переноса
# крупных видео (>20 МБ): облачный api.telegram.org не даёт скачивать файлы
# больше 20 МБ и отправлять больше 50 МБ, локальный сервер поднимает лимит до
# 2 ГБ. Пусто -> используется облачный API. Запуск сервера см. README.
TG_API_URL=
# TG_API_LOCAL=1 — только если сервер запущен с флагом --local (бот и сервер на
# одной машине, файлы читаются с диска напрямую). Без --local оставь пустым.
TG_API_LOCAL=

# (необязательно) начальная пара. Чаты обычно связывают командой /link,
# но если заполнить — при первом запуске пара попадёт в реестр автоматически.
TG_CHAT_ID=
VK_PEER_ID=

# --- VK ---
# Ключ доступа сообщества с правами "Сообщения" (messages).
# Управление сообществом -> Настройки -> Работа с API -> Ключи доступа.
VK_TOKEN=vk1.a.xxxxxxxx
# (необязательно) числовой id сообщества. Если пусто — определяется автоматически.
VK_GROUP_ID=

# (необязательно) токен ЛИЧНОГО аккаунта VK — только для нативного видео:
#   TG->VK заливает настоящим видео (video.save), VK->TG скачивает mp4 (video.get).
# Если пусто: TG->VK видео = документ, VK->TG видео = превью+ссылка.
# Как получить — см. README (Kate Mobile / implicit flow).
VK_USER_TOKEN=

# (необязательно) куки для видео по ссылке (если YouTube/IG просит авторизацию):
#   YTDLP_COOKIES_FROM_BROWSER=firefox    (или chrome / edge / chrome:Profile 1)
#   YTDLP_COOKIES=C:\путь\cookies.txt
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES=

# --- Discord (опционально) ---
# Если DISCORD_TOKEN пуст — Discord-наблюдатель не запускается, мост работает как обычно.
# Токен бота из Discord Developer Portal -> ваше приложение -> Bot -> Reset Token.
# ВАЖНО: в разделе Bot включите привилегированные интенты:
#   Server Members Intent и Presence Intent (иначе не видно участников и игр).
# Бот следит за голосовыми каналами Discord и шлёт события (заходы/выходы) и /vc
# в привязанные чаты моста (Telegram + VK). Привязка — в Telegram: /ds_connect.
DISCORD_TOKEN=

# --- Распознавание речи голосовых (опционально) ---
# Голосовые сообщения автоматически расшифровываются в текст и присылаются
# ответом в оба чата (в VK — на оригинал, в TG — на пересланную версию, и наоборот
# для голосовых из TG). Работает offline через Vosk.
# Что нужно:
#   1) pip install vosk
#   2) системный ffmpeg (Ubuntu: apt install ffmpeg)
#   3) скачать модель и указать путь ниже. Русская модель ~45 МБ:
#      https://alphacephei.com/vosk/models -> vosk-model-small-ru-0.22
#      (распаковать и указать путь к папке модели).
# Если VOSK_MODEL_PATH пуст и папки vosk-model в корне проекта нет — фича выключена.
VOSK_MODEL_PATH=
# (необязательно) путь к ffmpeg, если его нет в PATH.
FFMPEG_BIN=

# --- Веб-приложение «альты» (Telegram Mini App, команда /alt web) ---
# Кнопка /alt web открывает мини-приложение со списком альтов: поиск, фильтры
# по датам, превью (миниатюры подгружаются по запросу, на диск не пишутся),
# аватарка автора, отправка альта в чат одним тапом.
# Включается, когда заданы ОБЕ переменные ниже. Если пусто — фича выключена.
# Настройка (см. README, раздел «Веб-приложение альтов»):
#   1) публичный HTTPS-домен на сервер (напр. бесплатный DuckDNS) + Caddy
#      (авто-сертификат Let's Encrypt), проксирующий 443 -> WEBAPP_PORT;
#   2) в @BotFather: /newapp -> выбрать бота -> Web App URL = WEBAPP_PUBLIC_URL,
#      задать короткое имя -> вписать его в WEBAPP_BOT_APP.
WEBAPP_PUBLIC_URL=
WEBAPP_BOT_APP=
# (необязательно) интерфейс/порт локального веб-сервера (за реверс-прокси).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8090

# Уровень логирования
LOG_LEVEL=INFO
